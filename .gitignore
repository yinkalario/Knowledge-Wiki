# Operating-system noise
.DS_Store
Thumbs.db

# Obsidian per-device UI state and sync-conflict copies
.obsidian/workspace*.json

# Disposable runtime and temporary files
# Ad hoc top-level tmp/ or temp/ directories are intentionally not ignored; use OS temp or _runtime/ per WORKFLOW.md.
_runtime/
*.tmp
*.temp
*.swp
*~

# Local credentials and environment overrides
.env
.env.*
!.env.example
.claude/settings.local.json
.codex/

# Obsidian trash is recoverable UI state, not knowledge
.trash/

# Externally managed evidence and delivery content; keep directory markers in Git
/raw/**
!/raw/**/
!/raw/**/.gitkeep
/inbox/**
!/inbox/**/
!/inbox/**/.gitkeep
